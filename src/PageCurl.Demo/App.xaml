<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="PageCurl.Demo.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="CanvasLight">#F0EEE8</Color>
            <Color x:Key="CanvasDark">#171816</Color>
            <Color x:Key="StageLight">#DDD9CF</Color>
            <Color x:Key="StageDark">#22231F</Color>
            <Color x:Key="PaperLight">#FAF8F1</Color>
            <Color x:Key="PaperDark">#2A2B27</Color>
            <Color x:Key="InkLight">#1C211F</Color>
            <Color x:Key="InkDark">#F1F0E9</Color>
            <Color x:Key="MutedLight">#6E736E</Color>
            <Color x:Key="MutedDark">#A9ADA6</Color>
            <Color x:Key="RuleLight">#C9C7BE</Color>
            <Color x:Key="RuleDark">#3B3D38</Color>
            <Color x:Key="Cobalt">#3157D5</Color>
            <Color x:Key="CobaltPressed">#2444AD</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.7" />
                <Setter Property="TextColor" Value="{StaticResource Cobalt}" />
            </Style>
            <Style x:Key="QuietText" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PaperLight}, Dark={StaticResource PaperDark}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource RuleLight}, Dark={StaticResource RuleDark}}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource RuleLight}, Dark={StaticResource RuleDark}}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>
            <Style x:Key="CobaltButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Cobalt}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>
            <Style x:Key="SceneButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="SceneButtonSelected" TargetType="Button" BasedOn="{StaticResource SceneButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Cobalt}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="MinimumTrackColor" Value="{StaticResource Cobalt}" />
                <Setter Property="ThumbColor" Value="{StaticResource Cobalt}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
