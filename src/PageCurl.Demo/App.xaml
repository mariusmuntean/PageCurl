<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="PageCurl.Demo.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBackgroundLight">#F3F0FA</Color>
            <Color x:Key="PageBackgroundDark">#0F1020</Color>
            <Color x:Key="SurfaceLight">#FFFCF5</Color>
            <Color x:Key="SurfaceDark">#191A31</Color>
            <Color x:Key="StageLight">#E8E2F7</Color>
            <Color x:Key="StageDark">#17182B</Color>
            <Color x:Key="BorderLight">#C7BEE4</Color>
            <Color x:Key="BorderDark">#3A3B58</Color>
            <Color x:Key="TextLight">#262035</Color>
            <Color x:Key="TextDark">#F7F2FF</Color>
            <Color x:Key="MutedLight">#665F79</Color>
            <Color x:Key="MutedDark">#C7C4D8</Color>
            <Color x:Key="AccentLight">#7658D8</Color>
            <Color x:Key="AccentDark">#9D7CFF</Color>
            <Color x:Key="WarmAccent">#F3B66F</Color>
            <Color x:Key="ButtonTextDark">#0F1020</Color>
            <LinearGradientBrush x:Key="PageBackgroundBrushLight" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F3F0FA" Offset="0" />
                <GradientStop Color="#FFF3E6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PageBackgroundBrushDark" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#11122A" Offset="0" />
                <GradientStop Color="#241D2D" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9D7CFF" Offset="0" />
                <GradientStop Color="#F3B66F" Offset="1" />
            </LinearGradientBrush>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>
            <Style x:Key="EyebrowLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.8" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
            </Style>
            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
            <Style x:Key="ReaderButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
            </Style>
            <Style x:Key="PrimaryReaderButton" TargetType="Button" BasedOn="{StaticResource ReaderButton}">
                <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                <Setter Property="TextColor" Value="{StaticResource ButtonTextDark}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
