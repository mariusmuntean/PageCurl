<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PageCurl.Demo.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:curl="clr-namespace:PageCurl.Maui;assembly=PageCurl.Maui"
    SafeAreaEdges="All"
    Background="{AppThemeBinding Light={StaticResource PageBackgroundBrushLight}, Dark={StaticResource PageBackgroundBrushDark}}">
    <Grid
        x:Name="RootLayout"
        Padding="20,18"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="14"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                WidthRequest="42"
                HeightRequest="42"
                Padding="0"
                Background="{StaticResource BrandBrush}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">
                <Label
                    Text="PC"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="{StaticResource ButtonTextDark}"
                    AutomationProperties.IsInAccessibleTree="False" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Text="PAGECURL" Style="{StaticResource EyebrowLabel}" />
                <Label Text="A tactile reading surface" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Border
                Grid.Column="2"
                Padding="10,7"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                VerticalOptions="Center">
                <Label
                    x:Name="StatusLabel"
                    Text="READY TO TURN"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                <Label Text="The page is the interface." FontSize="27" FontAttributes="Bold" />
                <Label
                    x:Name="PageHintLabel"
                    Text="Drag from a side or corner to reveal the next fold."
                    Style="{StaticResource MutedLabel}"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Border
                Grid.Column="1"
                Padding="12,9"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="PAGE" Style="{StaticResource EyebrowLabel}" HorizontalTextAlignment="Center" />
                    <Label x:Name="PageCounterLabel" Text="01 / 04" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="9"
            BackgroundColor="{AppThemeBinding Light={StaticResource StageLight}, Dark={StaticResource StageDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 26">
            <Grid
                x:Name="StageGrid"
                HeightRequest="340"
                MinimumHeightRequest="260"
                VerticalOptions="Center"
                SizeChanged="OnStageSizeChanged">
                <curl:PageTurnView
                    x:Name="PageView"
                    ContentScale="AspectFit"
                    SemanticProperties.Description="Interactive page. Drag from any free edge or corner to turn the page."
                    SurfaceColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />

                <Grid
                    x:Name="EdgeHintsOverlay"
                    InputTransparent="True"
                    ColumnDefinitions="42,*,42"
                    RowDefinitions="42,*,42"
                    Margin="8"
                    AutomationProperties.IsInAccessibleTree="False">
                    <Border
                        x:Name="TopLeftCornerHint"
                        Grid.Row="0"
                        Grid.Column="0"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Opacity="0.9">
                        <Label Text="↖" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        x:Name="TopRightCornerHint"
                        Grid.Row="0"
                        Grid.Column="2"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Opacity="0.9">
                        <Label Text="↗" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        x:Name="BottomLeftCornerHint"
                        Grid.Row="2"
                        Grid.Column="0"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Opacity="0.9">
                        <Label Text="↙" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        x:Name="BottomRightCornerHint"
                        Grid.Row="2"
                        Grid.Column="2"
                        WidthRequest="34"
                        HeightRequest="34"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Opacity="0.9">
                        <Label Text="↘" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        x:Name="TopEdgeHint"
                        Grid.Row="0"
                        Grid.Column="1"
                        WidthRequest="124"
                        HeightRequest="28"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Opacity="0.85">
                        <Label Text="⌃  TOP EDGE  ⌃" FontSize="10" CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        x:Name="LeftEdgeHint"
                        WidthRequest="30"
                        HeightRequest="112"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Opacity="0.85">
                        <Label Text="‹" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        x:Name="RightEdgeHint"
                        WidthRequest="30"
                        HeightRequest="112"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Opacity="0.85">
                        <Label Text="›" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                    <Border
                        x:Name="BottomEdgeHint"
                        Grid.Row="2"
                        Grid.Column="1"
                        WidthRequest="124"
                        HeightRequest="28"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Opacity="0.85">
                        <Label Text="⌄  BOTTOM EDGE  ⌄" FontSize="10" CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" AutomationProperties.IsInAccessibleTree="False" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="3" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label
                    Text="Drag any edge or corner. Hints fade after your first curl."
                    Style="{StaticResource MutedLabel}"
                    VerticalOptions="Center"
                    LineBreakMode="WordWrap" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Label Text="Reduce motion" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                    <Switch
                        x:Name="ReduceMotionSwitch"
                        IsToggled="{Binding Source={x:Reference PageView}, Path=ReduceMotion, Mode=TwoWay}"
                        SemanticProperties.Description="Reduce page-turn motion" />
                </HorizontalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Text="HINGE" Style="{StaticResource EyebrowLabel}" VerticalOptions="Center" />
                <Picker
                    x:Name="LockedEdgePicker"
                    Grid.Column="1"
                    Title="Auto — choose nearest free edge"
                    FontSize="13"
                    HeightRequest="42"
                    SelectedIndexChanged="OnLockedEdgeChanged"
                    SemanticProperties.Description="Select the stationary page edge" />
                <Label
                    x:Name="LockedEdgeLabel"
                    Grid.Column="2"
                    Text="AUTO"
                    Style="{StaticResource EyebrowLabel}"
                    VerticalOptions="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="Testing mode" Style="{StaticResource EyebrowLabel}" />
                    <Label Text="Live state, pose and frame diagnostics" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
                <Switch
                    Grid.Column="1"
                    x:Name="TestingModeSwitch"
                    Toggled="OnTestingModeToggled"
                    SemanticProperties.Description="Enable page-turn testing mode" />
            </Grid>
            <Border
                x:Name="TestingPanel"
                IsVisible="False"
                Padding="12"
                MaximumHeightRequest="146"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="RUNTIME PROBE" Style="{StaticResource EyebrowLabel}" />
                    <Label
                        x:Name="TestingStateLabel"
                        Text="IDLE · FORWARD · 0%"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="TestingPointerLabel"
                        Text="Pointer — · Start —"
                        Style="{StaticResource MutedLabel}" />
                    <Label
                        x:Name="TestingPoseLabel"
                        Text="Pose inactive"
                        Style="{StaticResource MutedLabel}" />
                    <Label
                        x:Name="TestingPerformanceLabel"
                        Text="Frames — · Render —"
                        Style="{StaticResource MutedLabel}" />
                    <Label
                        x:Name="TestingResultLabel"
                        Text="Last result —"
                        Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>
            <Button
                x:Name="HintsButton"
                Text="Show edge hints"
                IsVisible="False"
                HeightRequest="34"
                Padding="12,0"
                HorizontalOptions="Start"
                Clicked="OnShowHintsClicked"
                SemanticProperties.Description="Show the page edge and corner hints again" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Text="‹  Previous"
                    Style="{StaticResource ReaderButton}"
                    Clicked="OnPreviousClicked"
                    IsEnabled="{Binding CanTurnBackward}"
                    SemanticProperties.Description="Turn to previous page" />
                <Button
                    Grid.Column="1"
                    Text="Next page  ›"
                    Style="{StaticResource PrimaryReaderButton}"
                    Clicked="OnNextClicked"
                    IsEnabled="{Binding CanTurnForward}"
                    SemanticProperties.Description="Turn to next page" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
