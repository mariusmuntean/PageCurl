<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PageCurl.Demo.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:curl="clr-namespace:PageCurl.Maui;assembly=PageCurl.Maui"
    SafeAreaEdges="All"
    BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}">
    <Grid
        Padding="24,20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <VerticalStackLayout Spacing="1">
                <Label Text="PAGECURL" Style="{StaticResource Eyebrow}" />
                <Label Text="Paper, not pixels." FontSize="25" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End" VerticalOptions="Center">
                <Label x:Name="PageCounterLabel" Text="01 / 04" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" />
                <Label x:Name="StatusLabel" Text="Ready" Style="{StaticResource QuietText}" HorizontalTextAlignment="End" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1">
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource StageLight}, Dark={StaticResource StageDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">
                <curl:PageTurnView
                    x:Name="PageView"
                    ContentScale="AspectFit"
                    SemanticProperties.Description="Interactive page. Drag from any free edge or corner to turn the page."
                    SurfaceColor="{AppThemeBinding Light={StaticResource StageLight}, Dark={StaticResource StageDark}}" />
            </Border>

            <Border
                x:Name="SettingsPanel"
                IsVisible="False"
                WidthRequest="310"
                Margin="16"
                Padding="20"
                HorizontalOptions="End"
                VerticalOptions="Start"
                BackgroundColor="{AppThemeBinding Light={StaticResource PaperLight}, Dark={StaticResource PaperDark}}"
                Stroke="{AppThemeBinding Light={StaticResource RuleLight}, Dark={StaticResource RuleDark}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="SETTINGS" Style="{StaticResource Eyebrow}" />
                            <Label Text="Turn behaviour" FontSize="18" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Close"
                            Style="{StaticResource QuietButton}"
                            HeightRequest="36"
                            Padding="10,0"
                            Clicked="OnSettingsClicked"
                            SemanticProperties.Description="Close page curl settings" />
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="LOCKED EDGE" Style="{StaticResource Eyebrow}" />
                        <Picker
                            x:Name="LockedEdgePicker"
                            Title="Auto"
                            HeightRequest="44"
                            SelectedIndexChanged="OnLockedEdgeChanged"
                            SemanticProperties.Description="Select the stationary page edge" />
                        <Label x:Name="LockedEdgeLabel" Text="Auto selects the opposite edge." Style="{StaticResource QuietText}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Reduce motion" FontAttributes="Bold" />
                            <Label Text="Complete turns without settling." Style="{StaticResource QuietText}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            x:Name="ReduceMotionSwitch"
                            IsToggled="{Binding Source={x:Reference PageView}, Path=ReduceMotion, Mode=TwoWay}"
                            SemanticProperties.Description="Reduce page-turn motion" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Diagnostics" FontAttributes="Bold" />
                            <Label Text="Pose, timing and allocations." Style="{StaticResource QuietText}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            x:Name="TestingModeSwitch"
                            Toggled="OnTestingModeToggled"
                            SemanticProperties.Description="Enable page-turn diagnostics" />
                    </Grid>

                    <Border
                        x:Name="TestingPanel"
                        IsVisible="False"
                        Padding="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="TestingStateLabel" Text="IDLE · FORWARD · 0%" FontAttributes="Bold" FontSize="12" />
                            <Label x:Name="TestingPointerLabel" Text="Pointer — · Start —" Style="{StaticResource QuietText}" />
                            <Label x:Name="TestingPoseLabel" Text="Pose inactive" Style="{StaticResource QuietText}" />
                            <Label x:Name="TestingPerformanceLabel" Text="Frames — · Render —" Style="{StaticResource QuietText}" />
                            <Label x:Name="TestingResultLabel" Text="Last result —" Style="{StaticResource QuietText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                <Label x:Name="PageHintLabel" Text="Drag the page from any free edge." FontAttributes="Bold" FontSize="13" />
                <Label Text="The surface stays stiff and inextensible." Style="{StaticResource QuietText}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="1"
                Text="Previous"
                Style="{StaticResource QuietButton}"
                Clicked="OnPreviousClicked"
                IsEnabled="{Binding CanTurnBackward}"
                SemanticProperties.Description="Turn to previous page" />
            <Button
                Grid.Column="2"
                Text="Next"
                Style="{StaticResource CobaltButton}"
                Clicked="OnNextClicked"
                IsEnabled="{Binding CanTurnForward}"
                SemanticProperties.Description="Turn to next page" />
            <Button
                Grid.Column="3"
                Text="Settings"
                Style="{StaticResource QuietButton}"
                Clicked="OnSettingsClicked"
                SemanticProperties.Description="Open page curl settings" />
        </Grid>
    </Grid>
</ContentPage>
