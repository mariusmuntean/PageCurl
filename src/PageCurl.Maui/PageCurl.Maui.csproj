<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Apple targets (iOS/MacCatalyst) require a Mac, so they are only added on
         macOS. Windows is only added on Windows. This keeps a build on one host from
         pulling in targets that host can't compile. -->
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
    <AndroidResourceDesignerClassModifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">internal</AndroidResourceDesignerClassModifier>
    <IsPackable>true</IsPackable>
    <PackageId>PageCurl.Maui</PackageId>
    <Title>PageCurl.Maui</Title>
    <PackageIcon>pagecurl-icon.png</PackageIcon>
    <Description>Interactive stiff-paper page turns for images, live .NET MAUI views and two-page spreads.</Description>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- WinUI indexes referenced PRI resources under the consuming app's RID. -->
    <IsRidAgnostic Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</IsRidAgnostic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PageCurl.Core/PageCurl.Core.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- Keep the SkiaSharp.Views.Maui line aligned with net10.0 assets. -->
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.150.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/site/images/pagecurl-icon.png"
          Pack="true"
          PackagePath="pagecurl-icon.png"
          Visible="false" />
    <None Include="../../docs/package-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PageContentSnapshotter.cs" />
    <Compile Remove="Platforms/Android/PageContentSnapshotter.Android.cs" />
    <Compile Remove="PageContentSnapshotter.Apple.cs" />
    <Compile Remove="Platforms/Windows/PageContentSnapshotter.Windows.cs" />
    <Compile Include="PageContentSnapshotter.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''" />
    <Compile Include="Platforms/Android/PageContentSnapshotter.Android.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <Compile Include="PageContentSnapshotter.Apple.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    <Compile Include="Platforms/Windows/PageContentSnapshotter.Windows.cs"
             Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
  </ItemGroup>
</Project>
