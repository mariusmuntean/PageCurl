<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <AppBundleManifest>Platforms/MacCatalyst/Info.plist</AppBundleManifest>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>PageCurl Native Tests</ApplicationTitle>
    <ApplicationId>de.marius.PageCurlRegressionTests</ApplicationId>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <_AppBundleName>$(AssemblyName)</_AppBundleName>
    <ReaderExampleDirectory>$(BaseIntermediateOutputPath)reader-example/</ReaderExampleDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PageCurl.Core/PageCurl.Core.csproj" />
    <ProjectReference Include="../../src/PageCurl.Maui/PageCurl.Maui.csproj" />
    <Compile Include="../../src/PageCurl.Demo/*.cs" Link="Demo/%(Filename)%(Extension)" />
    <Compile Include="../../src/PageCurl.Demo/Views/*.cs" Link="Demo/Views/%(Filename)%(Extension)" />
    <MauiXaml Include="../../src/PageCurl.Demo/*.xaml" Link="Demo/%(Filename)%(Extension)" />
    <MauiXaml Include="../../src/PageCurl.Demo/Resources/Styles/*.xaml" Link="Resources/Styles/%(Filename)%(Extension)" />
    <MauiImage Include="../../src/PageCurl.Demo/Resources/Images/**" Link="Resources/Images/%(Filename)%(Extension)" />
    <MauiImage Include="../../docs/site/images/pagecurl-icon.png" Link="Resources/Images/pagecurl_brand.png" />
    <MauiAsset Include="../../src/PageCurl.Demo/Resources/Raw/**" LogicalName="%(Filename)%(Extension)" />
    <Compile Include="$(ReaderExampleDirectory)ReaderPage.xaml.cs" Link="ReaderExample/ReaderPage.xaml.cs" />
    <MauiXaml Include="$(ReaderExampleDirectory)ReaderPage.xaml" Link="ReaderExample/ReaderPage.xaml" />
    <PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <Target Name="ExtractReaderExample" BeforeTargets="PrepareForBuild"
          Inputs="../../docs/site/spreads.md;../../tools/extract-doc-example.py"
          Outputs="$(ReaderExampleDirectory)ReaderPage.xaml;$(ReaderExampleDirectory)ReaderPage.xaml.cs">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../tools/extract-doc-example.py&quot; &quot;$(MSBuildThisFileDirectory)../../docs/site/spreads.md&quot; &quot;$(ReaderExampleDirectory)&quot;" />
  </Target>
</Project>
