<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep package references aligned with the .NET 10 MAUI workload. -->
    <MauiVersion>10.0.110</MauiVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mariusmuntean/PageCurl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>maui;page-curl;skia;document;reader</PackageTags>
  </PropertyGroup>
</Project>
