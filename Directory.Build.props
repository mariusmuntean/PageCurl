<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep package references aligned with the .NET 10 MAUI workload. -->
    <MauiVersion>10.0.110</MauiVersion>
    <VersionPrefix>0.1.1</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Authors>Marius Muntean</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mariusmuntean/PageCurl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://mariusmuntean.github.io/PageCurl-docs/</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageTags>maui;page-curl;skia;document;reader</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'PageCurl.Core'
                         Or '$(MSBuildProjectName)' == 'PageCurl.Maui'
                         Or '$(MSBuildProjectName)' == 'PageCurl.Demo'">
    <AnalysisLevel>10.0-minimum</AnalysisLevel>
    <AnalysisLevelGlobalization>10.0-recommended</AnalysisLevelGlobalization>
  </PropertyGroup>
</Project>
